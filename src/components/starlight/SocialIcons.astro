---
// The site's own links in the docs header, before Starlight's social icons.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<nav class="mp-doclinks" aria-label="Site">
  <a href="/">Home</a>
  <a href="/docs/">Docs</a>
  <a href="/how-it-works/">How it works</a>
  <a href="/changelog/">Changelog</a>
</nav>
<Default />

<style>
  .mp-doclinks {
    display: none;
    gap: 1.25rem;
    margin-right: 0.75rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .mp-doclinks a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .mp-doclinks a:hover {
    color: var(--sl-color-white);
  }
  @media (min-width: 72rem) {
    .mp-doclinks {
      display: flex;
    }
  }
</style>
