---
import Site from '../layouts/Site.astro';
import Term from '../components/Term.astro';
---

<Site title="Not found · memprove" description="This page does not exist." noindex>
  <section class="page">
    <div class="wrap two">
      <div class="stack">
        <p class="cap">[ 404 ]</p>
        <h1 class="h2">Nothing is recorded at this address.</h1>
        <p class="txt">The page may have moved when the docs were regenerated from the repository. Start again from one of these:</p>
        <div class="btns">
          <a class="btn" href="/docs/">Docs</a>
          <a class="btn2" href="/">Home</a>
        </div>
      </div>
      <Term title="memprove">
        <div class="tbody">
          <div class="ln"><span class="glow">$</span> memprove resume --pack</div>
          <div class="wrapline"><span class="k-st">404 not_found</span>: no page at this path</div>
          <div class="wrapline dim">Rerun: open https://memprove.dev/docs/</div>
          <div class="ln"><span class="glow">❯</span><span class="cur"></span></div>
        </div>
      </Term>
    </div>
  </section>
</Site>
