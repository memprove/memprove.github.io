{
  "name": "memprove-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The memprove.dev website: homepage, docs (pulled from memprove/memprove), llms.txt",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "test:install": "bash scripts/test-install.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.8",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "astro": "7.4.4"
  },
  "engines": {
    "node": ">=22"
  }
}
